{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "memoria",
  "version": "1.1.0",
  "identifier": "com.evanflare.memoria",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "myConfig": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1N0ZCOTQxOEI2NkU0QUMKUldTczVHYUxRYmwvWmI4TGdMRDMwTGdPaCt0U2piZmVDNmpjSWJsREVySWJhTTJCNTJPcVdaVHgK",
      "endpoints": [
        "https://gitee.com/Evanflare/memoria/releases/download/latest/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "memoria",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../dist-isolation"
        }
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "android": {
      "autoIncrementVersionCode": true
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}